fields <- paste(
"status", "continent", "country", "countryCode", "region", "regionName",
"city", "district", "zip", "lat", "lon", "timezone", "currency",
"isp", "org", "as", "query",
sep = ","
)
get_ip_info <- function(ip) {
url <- paste0("http://ip-api.com/json/", ip, "?fields=", fields)
resp <- httr2::request(url) |>
httr2::req_perform() |>
httr2::resp_body_string() |>
jsonlite::fromJSON()
as.data.frame(resp)
}
ip_df <- purrr::map_df(.x = toxic_ips$IP, .f = get_ip_info)
nrow(ip_df)   # should print 10
ncol(ip_df)   # should print 17
ip_df
